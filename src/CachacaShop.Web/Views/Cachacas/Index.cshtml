@model List<Cachaca>
@{
    ViewData["Title"] = "Cachaças";
    var produtores = (Dictionary<string, string>)ViewBag.Produtores;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Cachaças</h2>
    <a class="btn btn-success" asp-action="Create">+ Nova cachaça</a>
</div>

<table class="table table-striped table-sm">
    <thead>
    <tr>
        <th>Nome</th><th>Produtor</th><th>Tipo</th><th>Madeira</th><th>Teor</th><th>Volume</th>
        <th class="text-end">Preço</th><th class="text-end">Estoque</th><th>Repor</th><th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Nome</td>
            <td>@produtores.GetValueOrDefault(c.ProdutorId, "?")</td>
            <td>@Fmt.Rotulo(c.Tipo)</td>
            <td>@Fmt.Rotulo(c.Madeira)@(c.MesesEnvelhecimento > 0 ? $" ({c.MesesEnvelhecimento}m)" : "")</td>
            <td>@Fmt.Percentual(c.TeorAlcoolico)</td>
            <td>@c.VolumeMl ml</td>
            <td class="text-end">@Fmt.Moeda(c.Preco)</td>
            <td class="text-end">
                <span class="badge @(c.Estoque <= 5 ? "bg-danger" : "bg-secondary")">@c.Estoque</span>
            </td>
            <td>
                <form asp-action="ReporEstoque" asp-route-id="@c.Id" method="post" class="d-flex gap-1">
                    <input type="number" name="quantidade" min="1" value="10" class="form-control form-control-sm" style="width:5rem" />
                    <button class="btn btn-sm btn-outline-success">+</button>
                </form>
            </td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                      data-confirm="Remover a cachaça @c.Nome?">
                    <button class="btn btn-sm btn-outline-danger">Remover</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
