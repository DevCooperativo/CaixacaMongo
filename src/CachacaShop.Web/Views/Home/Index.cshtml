@model List<Cachaca>
@{
    ViewData["Title"] = "Início";
}

<div class="p-4 mb-4 bg-light rounded-3 border">
    <h1 class="display-6 text-cachaca">Alambique Online</h1>
    <p class="lead mb-3">E-commerce de cachaças artesanais direto dos alambiques brasileiros.</p>
    <a class="btn btn-dark" asp-controller="Consultas" asp-action="Catalogo">Ver catálogo</a>
    <a class="btn btn-outline-dark" asp-controller="Pedidos" asp-action="Create">Novo pedido</a>
</div>

<h4 class="mb-3">Destaques da casa</h4>
<div class="row row-cols-1 row-cols-md-3 g-3">
    @foreach (var c in Model)
    {
        <div class="col">
            <div class="card h-100 card-cachaca">
                <div class="card-body">
                    <h5 class="card-title">@c.Nome</h5>
                    <p class="text-muted small mb-2">
                        @Fmt.Rotulo(c.Tipo) · @Fmt.Rotulo(c.Madeira) · @Fmt.Percentual(c.TeorAlcoolico) · @c.VolumeMl ml
                    </p>
                    <p class="card-text">@c.Descricao</p>
                </div>
                <div class="card-footer bg-white d-flex justify-content-between">
                    <strong>@Fmt.Moeda(c.Preco)</strong>
                    <span class="text-muted small">@c.Estoque em estoque</span>
                </div>
            </div>
        </div>
    }
</div>
