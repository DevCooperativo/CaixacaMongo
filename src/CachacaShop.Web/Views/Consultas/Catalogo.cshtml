@model CatalogoViewModel
@{
    ViewData["Title"] = "Catálogo";
}

<h2>1. Catálogo com filtros</h2>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label" asp-for="Nome">Nome contém</label>
        <input asp-for="Nome" class="form-control" placeholder="ex.: amburana" />
    </div>
    <div class="col-md-2">
        <label class="form-label" asp-for="Tipo"></label>
        <select asp-for="Tipo" asp-items="Fmt.Tipos()" class="form-select"><option value="">Todos</option></select>
    </div>
    <div class="col-md-2">
        <label class="form-label" asp-for="Madeira"></label>
        <select asp-for="Madeira" asp-items="Fmt.Madeiras()" class="form-select"><option value="">Todas</option></select>
    </div>
    <div class="col-md-1">
        <label class="form-label" asp-for="PrecoMinimo">Preço mín.</label>
        <input asp-for="PrecoMinimo" class="form-control" step="0.01" />
    </div>
    <div class="col-md-1">
        <label class="form-label" asp-for="PrecoMaximo">Preço máx.</label>
        <input asp-for="PrecoMaximo" class="form-control" step="0.01" />
    </div>
    <div class="col-md-2">
        <div class="form-check">
            <input asp-for="SomenteDisponiveis" class="form-check-input" />
            <label asp-for="SomenteDisponiveis" class="form-check-label">Só disponíveis</label>
        </div>
    </div>
    <div class="col-md-1"><button class="btn btn-primary w-100">Buscar</button></div>
</form>

<p class="text-muted">@Model.Resultado.Count resultado(s), ordenados pelo preço.</p>
<table class="table table-striped table-sm">
    <thead><tr><th>Nome</th><th>Produtor</th><th>Tipo</th><th>Madeira</th><th>Teor</th><th class="text-end">Preço</th><th class="text-end">Estoque</th></tr></thead>
    <tbody>
    @foreach (var c in Model.Resultado)
    {
        <tr>
            <td>@c.Nome</td>
            <td>@Model.Produtores.GetValueOrDefault(c.ProdutorId, "?")</td>
            <td>@Fmt.Rotulo(c.Tipo)</td>
            <td>@Fmt.Rotulo(c.Madeira)</td>
            <td>@Fmt.Percentual(c.TeorAlcoolico)</td>
            <td class="text-end">@Fmt.Moeda(c.Preco)</td>
            <td class="text-end">@c.Estoque</td>
        </tr>
    }
    </tbody>
</table>
