@model FaturamentoViewModel
@{
    ViewData["Title"] = "Faturamento mensal";
}

<h2>6. Faturamento mensal</h2>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-2">
        <label class="form-label" asp-for="Ano"></label>
        <input asp-for="Ano" class="form-control" min="2000" max="2100" />
    </div>
    <div class="col-md-2"><button class="btn btn-primary">Buscar</button></div>
</form>

<p class="text-muted">Considera pedidos pagos, enviados e entregues.</p>
<table class="table table-striped table-sm">
    <thead><tr><th>Mês</th><th class="text-end">Pedidos</th><th class="text-end">Ticket médio</th><th class="text-end">Faturamento</th></tr></thead>
    <tbody>
    @foreach (var f in Model.Resultado)
    {
        <tr>
            <td>@Fmt.MesAno(f.Ano, f.Mes)</td>
            <td class="text-end">@f.QuantidadePedidos</td>
            <td class="text-end">@Fmt.Moeda(f.TicketMedio)</td>
            <td class="text-end">@Fmt.Moeda(f.Faturamento)</td>
        </tr>
    }
    </tbody>
    <tfoot>
    <tr class="fw-bold">
        <td>Total do ano</td>
        <td class="text-end">@Model.Resultado.Sum(f => f.QuantidadePedidos)</td>
        <td></td>
        <td class="text-end">@Fmt.Moeda(Model.Resultado.Sum(f => f.Faturamento))</td>
    </tr>
    </tfoot>
</table>
