@model PedidosClienteViewModel
@{
    ViewData["Title"] = "Pedidos do cliente";
}

<h2>4. Pedidos de um cliente</h2>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label" asp-for="ClienteId">Cliente</label>
        <select asp-for="ClienteId" asp-items="ViewBag.Clientes" class="form-select"><option value="">Selecione...</option></select>
    </div>
    <div class="col-md-2">
        <label class="form-label" asp-for="Status"></label>
        <select asp-for="Status" asp-items="Fmt.Status()" class="form-select"><option value="">Todos</option></select>
    </div>
    <div class="col-md-2">
        <label class="form-label" asp-for="De">De</label>
        <input asp-for="De" type="date" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label" asp-for="Ate">Até</label>
        <input asp-for="Ate" type="date" class="form-control" />
    </div>
    <div class="col-md-2"><button class="btn btn-primary">Buscar</button></div>
</form>

@if (Model.Resultado is not null)
{
    <p class="text-muted">
        @Model.Resultado.Count pedido(s) · total gasto (exceto cancelados):
        <strong>@Fmt.Moeda(Model.Resultado.Where(p => p.Status != StatusPedido.Cancelado).Sum(p => p.Total))</strong>
    </p>
    <table class="table table-striped table-sm">
        <thead><tr><th>Data</th><th>Itens</th><th class="text-end">Total</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model.Resultado)
        {
            <tr>
                <td>@Fmt.DataHora(p.Data)</td>
                <td class="small">@string.Join(", ", p.Itens.Select(i => $"{i.Quantidade}x {i.NomeCachaca}"))</td>
                <td class="text-end">@Fmt.Moeda(p.Total)</td>
                <td><span class="badge bg-@Fmt.CorStatus(p.Status)">@Fmt.Rotulo(p.Status)</span></td>
                <td class="text-end"><a asp-controller="Pedidos" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Abrir</a></td>
            </tr>
        }
        </tbody>
    </table>
}
