@model PorEstadoViewModel
@{
    ViewData["Title"] = "Cachaças por estado";
}

<h2>2. Cachaças por estado do produtor</h2>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label" asp-for="Estado">UF do produtor</label>
        <select asp-for="Estado" asp-items="ViewBag.Estados" class="form-select"><option value="">Selecione...</option></select>
    </div>
    <div class="col-md-2"><button class="btn btn-primary">Buscar</button></div>
</form>

@if (!string.IsNullOrEmpty(Model.Estado))
{
    <p class="text-muted">@Model.Resultado.Count cachaça(s) de produtores de @Model.Estado.</p>
    <table class="table table-striped table-sm">
        <thead><tr><th>Produtor</th><th>Cidade</th><th>Cachaça</th><th>Tipo</th><th class="text-end">Preço</th><th class="text-end">Estoque</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Resultado)
        {
            <tr>
                <td>@r.Produtor</td>
                <td>@r.Cidade/@r.Estado</td>
                <td>@r.Cachaca</td>
                <td>@Fmt.Rotulo(r.Tipo)</td>
                <td class="text-end">@Fmt.Moeda(r.Preco)</td>
                <td class="text-end">@r.Estoque</td>
            </tr>
        }
        </tbody>
    </table>
}
