@model List<Produtor>
@{
    ViewData["Title"] = "Produtores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Produtores (alambiques)</h2>
    <a class="btn btn-success" asp-action="Create">+ Novo produtor</a>
</div>

<table class="table table-striped">
    <thead>
    <tr><th>Nome</th><th>Cidade/UF</th><th>Fundação</th><th>Descrição</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Nome</td>
            <td>@p.Cidade/@p.Estado</td>
            <td>@p.AnoFundacao <span class="text-muted small">(@p.AnosDeTradicao anos)</span></td>
            <td class="small">@p.Descricao</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Editar</a>
                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                      data-confirm="Remover o produtor @p.Nome?">
                    <button class="btn btn-sm btn-outline-danger">Remover</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
