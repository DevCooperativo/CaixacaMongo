@model List<Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Clientes</h2>
    <a class="btn btn-success" asp-action="Create">+ Novo cliente</a>
</div>

<table class="table table-striped">
    <thead>
    <tr><th>Nome</th><th>E-mail</th><th>Idade</th><th>Endereço</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Nome</td>
            <td>@c.Email</td>
            <td>@c.Idade</td>
            <td class="small">@c.Endereco</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" asp-controller="Consultas" asp-action="PedidosCliente"
                   asp-route-clienteId="@c.Id">Pedidos</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                      data-confirm="Remover o cliente @c.Nome?">
                    <button class="btn btn-sm btn-outline-danger">Remover</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
